{
  "name": "one-mcp",
  "version": "1.2.0",
  "description": "Single-point proxy for Model Context Protocol servers — routes agent MCP calls to 10+ backend MCP servers with on-demand spawning, health tracking, and hot-reload config.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "bin": {
    "one-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "config/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --target=bun --outdir=dist src/index.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "expose": "bun run scripts/expose.ts",
    "expose:open": "bun run scripts/expose-open.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samanvaya5/one-mcp"
  },
  "homepage": "https://github.com/samanvaya5/one-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "proxy",
    "router",
    "ai",
    "llm",
    "agent",
    "tools",
    "sse",
    "stdio",
    "claude",
    "anthropic"
  ],
  "author": "Samanvaya Yagsen",
  "license": "MIT",
  "preferGlobal": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "chokidar": "^5.0.0",
    "zod": "^4.3.6"
  }
}
